# Copy this file to .env and fill in the values. Never commit .env.
APP_ENV=development            # development | test | production
FRONTEND_URL=http://localhost:5173

# MongoDB (Atlas free tier for development; use your own database name)
MONGODB_URI=
MONGODB_DB=listmates_yourname

# Google sign-in, Calendar, Meet and Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Sessions
JWT_SECRET=

# AI (OpenAI-compatible)
AI_PROVIDER=groq               # groq | gemini
GROQ_API_KEY=
GEMINI_API_KEY=

# Monitoring
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
